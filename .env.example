# Copy to .env and adjust. All variables are optional; defaults are shown.
# Reference: docs/configuration.md

# --- Server ---------------------------------------------------------------
# TST_HOST=127.0.0.1          # 0.0.0.0 exposes the app to the network
# TST_PORT=7860
# TST_ROOT_PATH=              # e.g. /style when served under a path by a reverse proxy

# --- Language model (any OpenAI-compatible chat-completions endpoint) ------
TST_LLM_BASE_URL=http://localhost:8000/v1
TST_LLM_API_KEY=replace-me
TST_LLM_MODEL=local-model
# TST_LLM_TIMEOUT=120         # seconds per request
# TST_LLM_MAX_ATTEMPTS=3      # including the first attempt
# TST_LLM_RETRY_DELAY=2       # seconds, doubled after each attempt
# TST_LLM_DEADLINE=300        # seconds in total per call
# TST_LLM_CONCURRENCY=2       # simultaneous model requests of this app
# TST_LLM_EXTRA_BODY={"temperature": 0.7}   # merged into every request

# --- Limits ---------------------------------------------------------------
# TST_MAX_INPUT_TOKENS=10000  # estimated tokens per text
# TST_MIN_INPUT_TOKENS=20
# TST_OUTPUT_TOKEN_FACTOR=2.5
# TST_OUTPUT_TOKEN_MIN=512
# TST_OUTPUT_TOKEN_MAX=8000
# TST_MAX_UPLOAD=5mb

# --- Retention ------------------------------------------------------------
# TST_SESSION_TTL=3600        # seconds a session's data is kept without activity
# TST_TEMP_TTL=1800           # seconds export files are kept
# TST_HISTORY_SIZE=20

# --- Operation ------------------------------------------------------------
# TST_AUTH_HEADER=            # e.g. X-Remote-User when a reverse proxy authenticates
# TST_PROFILE_DIR=            # directory with additional profile JSON files (read-only)
# TST_PRIVACY_NOTICE_FILE=    # Markdown file shown under "About"
# TST_SECURITY_HEADERS=true
