  "examples": {
    "formal.positive": "forma „Pan/Pani/Państwo”, pełne zdania, formalne spójniki jak „ponadto”, „w związku z tym”",
    "formal.negative": "zwracanie się na „ty”, potoczne słownictwo, wtrącenia jak „no”, „wiesz”, „w sumie”",
    "polite.positive": "„proszę”, „czy mógłby Pan…”, tryb przypuszczający, podziękowania, uzasadnienia",
    "polite.negative": "suche tryby rozkazujące, „musi Pan”, brak zwrotów grzecznościowych, bezpośrednie zarzuty",
    "personal.positive": "„ja”, „my”, „Pan/Pani” lub „ty” jako podmiot, czasowniki w 1. osobie",
    "personal.negative": "formy bezosobowe na -no/-to („zrobiono”), „się” bezosobowe, strona bierna",
    "confident.positive": "tryb oznajmujący, „z pewnością”, brak zastrzeżeń",
    "confident.negative": "tryb przypuszczający, „może”, „moim skromnym zdaniem”",
    "hedging": "„mógłby”, „wydaje się”, „prawdopodobnie”, „w pewnym stopniu”, tryb przypuszczający",
    "nominal.positive": "rzeczowniki odczasownikowe na -anie/-enie, -ość, „dokonać analizy”, łańcuchy dopełniaczy",
    "nominal.negative": "pełne czasowniki („analizować” zamiast „dokonać analizy”), niewiele nominalizacji",
    "active.positive": "strona czynna z nazwanymi wykonawcami",
    "active.negative": "strona bierna z „być” lub „zostać” („zostało postanowione”), formy na -no/-to",
    "nostalgic": "czas przeszły, „dawniej”, „wtedy”, „w tamtych latach”",
    "intensifiers": "„bardzo”, „niezwykle”, „całkowicie”, „ledwo”, „trochę”",
    "subjectivity_example": "„Autorka ocenia X jako Y”"
  },
