    "polite.positive": "'please', 'could you', 'would you mind', 'thank you', reasons given",
    "polite.negative": "bare imperatives, 'you must', no greetings, blunt accusations",
    "personal.positive": "'I', 'we', 'you' as sentence subjects",
    "personal.negative": "'one', 'it is …', passive voice, things as subjects",
    "confident.positive": "'will', 'is', 'clearly', no qualifiers",
    "confident.negative": "'might', 'perhaps', 'as far as I can judge'",
    "hedging": "'may', 'might', 'tends to', 'arguably', 'to some extent', 'under certain conditions'",
    "nominal.positive": "nominalisations in -tion, -ment, -ance, 'carry out an analysis', 'make a decision', chains of 'of' phrases",
    "nominal.negative": "full verbs ('analyse' instead of 'carry out an analysis'), few nominalisations",
    "active.positive": "active voice with named agents",
    "active.negative": "be-passive ('is done'), get-passive, 'it was decided that'",
    "nostalgic": "past tense, 'back then', 'in those days', 'used to'",
    "intensifiers": "'very', 'extremely', 'totally', 'hardly', 'a little'",
