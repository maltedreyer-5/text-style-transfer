  "examples": {
    "formal.positive": "tratamiento de usted, oraciones completas, conectores cultos como «asimismo», «por consiguiente»",
    "formal.negative": "tuteo, coloquialismos, muletillas como «pues», «vale», «o sea», «bueno»",
    "polite.positive": "«por favor», «¿podría usted…?», condicional de cortesía, agradecimientos, justificaciones",
    "polite.negative": "imperativos secos, «tiene que», sin fórmulas de cortesía, reproches directos",
    "personal.positive": "«yo», «nosotros», «usted» o «tú» como sujetos, verbos en primera persona",
    "personal.negative": "«se» impersonal, «uno», voz pasiva, sujetos inanimados",
    "confident.positive": "indicativo, futuro, «sin duda», sin matizaciones",
    "confident.negative": "condicional, «quizás», «en mi modesta opinión»",
    "hedging": "«podría», «parece», «es posible que» con subjuntivo, «en cierta medida»",
    "nominal.positive": "nominalizaciones en -ción, -miento, -dad, «llevar a cabo un análisis», cadenas de complementos con «de»",
    "nominal.negative": "verbos plenos («analizar» en lugar de «llevar a cabo un análisis»), pocas nominalizaciones",
    "active.positive": "voz activa con agentes nombrados",
    "active.negative": "pasiva con «ser» («fue aprobado»), pasiva refleja («se decidió»)",
    "nostalgic": "pretérito imperfecto, «en aquel entonces», «antes», «en aquellos años»",
    "intensifiers": "«muy», «extremadamente», «totalmente», «apenas», «un poco»",
    "subjectivity_example": "«La autora considera X como Y»"
  },
